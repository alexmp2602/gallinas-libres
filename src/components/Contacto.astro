---
const action =
  import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://formspree.io/f/myzployj";
---

<section
  id="contacto"
  aria-labelledby="contacto-title"
  class="bg-yolk py-24 md:py-32"
>
  <div class="site-container grid gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-24">
    <div class="reveal">
      <p class="eyebrow mb-5">Contacto</p>
      <h2
        id="contacto-title"
        class="font-display text-5xl leading-none tracking-tight md:text-7xl"
      >
        Hablemos de tu próximo <em class="font-normal text-white">pedido.</em>
      </h2>
      <p class="mt-7 max-w-md leading-7 text-ink/70">
        Contanos qué necesitás. Te respondemos para conversar cantidades,
        frecuencia y zona de entrega.
      </p>
      <a
        href="https://wa.me/5492324560122?text=Hola%2C%20quiero%20consultar%20por%20huevos%20mayoristas."
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-full border-2 border-ink px-6 py-3 font-bold transition hover:bg-ink hover:text-white"
      >
        Escribir por WhatsApp
      </a>
    </div>

    <form
      id="contact-form"
      action={action}
      method="POST"
      class="reveal grid gap-6"
      aria-describedby="contact-status"
    >
      <div class="sr-only" aria-hidden="true">
        <label for="website">Dejá este campo vacío</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-bold">
          Nombre y apellido
          <input
            required
            name="name"
            autocomplete="name"
            class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none"
          />
        </label>
        <label class="grid gap-2 text-sm font-bold">
          Teléfono
          <input
            required
            name="phone"
            type="tel"
            autocomplete="tel"
            class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none"
          />
        </label>
      </div>

      <label class="grid gap-2 text-sm font-bold">
        Email
        <input
          required
          name="email"
          type="email"
          autocomplete="email"
          class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none"
        />
      </label>

      <label class="grid gap-2 text-sm font-bold">
        ¿En qué podemos ayudarte?
        <textarea
          required
          name="message"
          rows="4"
          class="resize-y border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none"
        >
        </textarea>
      </label>

      <input
        type="hidden"
        name="_subject"
        value="Nueva consulta desde gallinaslibres.com"
      />
      <button
        type="submit"
        class="mt-3 justify-self-start rounded-full bg-ink px-8 py-4 font-bold text-white transition hover:bg-forest disabled:opacity-60"
      >
        Enviar consulta →
      </button>
      <p
        id="contact-status"
        role="status"
        aria-live="polite"
        class="min-h-6 text-sm font-semibold"
      >
      </p>
    </form>
  </div>

  <script is:inline>
    const form = document.querySelector("#contact-form");
    const status = document.querySelector("#contact-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get("website")) return;

      const button = form.querySelector("button");
      button.disabled = true;
      status.textContent = "Enviando…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: data,
        });
        if (!response.ok) throw new Error();
        form.reset();
        status.textContent = "¡Gracias! Te contactamos a la brevedad.";
      } catch {
        status.textContent =
          "No pudimos enviarlo. Probá por WhatsApp o intentá nuevamente.";
      } finally {
        button.disabled = false;
      }
    });
  </script>
</section>
