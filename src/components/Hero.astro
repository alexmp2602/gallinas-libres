---
const HERO_SRC = "/img/hero-gallinas.webp";
---

<section
  id="inicio"
  aria-labelledby="hero-title"
  class="grain relative flex min-h-[44rem] items-end overflow-hidden bg-forest text-white md:min-h-screen"
>
  <img
    src={HERO_SRC}
    alt="Gallinas recorriendo libremente el campo"
    width="1673"
    height="940"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgba(19,29,17,.82)_0%,rgba(19,29,17,.38)_58%,rgba(19,29,17,.15)_100%)]"
  >
  </div>

  <div class="site-container relative z-10 pb-14 pt-40 md:pb-20">
    <p class="eyebrow mb-6 text-yolk">Producción local · Goldney</p>

    <h1
      id="hero-title"
      class="font-display max-w-4xl text-balance text-[clamp(3.5rem,8vw,7.5rem)] leading-[.89] tracking-[-.05em]"
    >
      Huevos de gallinas que viven
      <em class="font-normal text-yolk"> libres.</em>
    </h1>

    <div
      class="mt-9 flex max-w-3xl flex-col gap-7 border-t border-white/30 pt-7 md:flex-row md:items-center md:justify-between"
    >
      <p class="max-w-xl text-lg leading-relaxed text-white/85">
        Producción responsable y abastecimiento de huevos frescos para comercios
        y mayoristas.
      </p>

      <a
        href="#contacto"
        class="inline-flex shrink-0 items-center justify-center gap-3 rounded-full bg-yolk px-6 py-4 font-bold text-ink transition hover:bg-white"
      >
        Consultar por mayorista <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
