---
const year = new Date().getFullYear();
---

<footer class="bg-ink py-12 text-white">
  <div class="site-container grid gap-10 md:grid-cols-3 md:items-end">
    <div>
      <img
        src="/img/logo/logo_4-1_transparente.png"
        alt="Gallinas Libres"
        width="1200"
        height="300"
        class="h-14 w-auto"
      />
      <p class="mt-4 text-sm text-white/55">
        Huevos frescos de producción responsable.
      </p>
    </div>
    <nav
      class="flex flex-wrap gap-5 text-sm md:justify-center"
      aria-label="Pie de página"
    >
      <a href="#nosotros">Nosotros</a>
      <a href="#produccion">Producción</a>
      <a href="#mayoristas">Mayoristas</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="text-sm text-white/55 md:text-right">
      <a
        href="https://www.facebook.com/gallinaslibres.fb/"
        target="_blank"
        rel="noopener"
        class="text-white">Facebook ↗</a
      >
      <p class="mt-4">© {year} Gallinas Libres</p>
    </div>
  </div>
</footer>
