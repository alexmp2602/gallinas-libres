---
import IconBrandFacebook from "../components/icons/IconBrandFacebook.astro";
import IconBrandWhatsapp from "../components/icons/IconBrandWhatsapp.astro";

const year = new Date().getFullYear();
---

<footer
  id="footer"
  role="contentinfo"
  class="w-full px-4 py-6 text-center text-sm text-neutral-500
         opacity-0 translate-y-6 transition-[opacity,transform] duration-700 ease-out will-change-transform
         border-t border-neutral-200 flex flex-col items-center gap-2"
>
  <p>© {year} Gallinas Libres — Todos los derechos reservados</p>

  <div class="flex items-center gap-4">
    <a
      href="https://www.facebook.com/gallinaslibres.fb/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook Gallinas Libres"
      class="hover:text-neutral-700 transition-colors"
    >
      <IconBrandFacebook size={22} className="w-5 h-5" />
    </a>

    <a
      href="https://wa.me/549XXXXXXXXXX"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp Gallinas Libres"
      class="hover:text-neutral-700 transition-colors"
    >
      <IconBrandWhatsapp size={22} className="w-5 h-5" />
    </a>
  </div>

  <script is:inline>
    (() => {
      const el = document.getElementById("footer");
      if (!el) return;

      const show = () => {
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      };

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        show();
        return;
      }

      const rect = el.getBoundingClientRect();
      if (rect.top < innerHeight && rect.bottom > 0) {
        show();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            show();
            io.disconnect();
          }
        },
        { root: null, rootMargin: "0px 0px -10% 0px", threshold: 0.01 }
      );
      io.observe(el);
    })();
  </script>
</footer>
