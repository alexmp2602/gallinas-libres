---
const etapas = [
  {
    number: "01",
    title: "Cuidado",
    text: "Acompañamos cada etapa de vida respetando el comportamiento natural y el bienestar de nuestras gallinas.",
  },
  {
    number: "02",
    title: "Alimentación",
    text: "Preparamos dietas balanceadas con vitaminas y minerales, ajustadas con precisión según cada etapa.",
  },
  {
    number: "03",
    title: "Recolección",
    text: "Recolectamos todos los días para preservar la frescura, el sabor y la calidad de cada huevo.",
  },
  {
    number: "04",
    title: "Distribución",
    text: "Preparamos los pedidos y coordinamos entregas regulares para comercios y clientes mayoristas.",
  },
];
---

<section
  id="produccion"
  aria-labelledby="produccion-title"
  class="bg-cream py-24 md:py-36"
>
  <div class="site-container">
    <div class="reveal max-w-3xl">
      <p class="eyebrow mb-5 text-clay">Del campo a tu comercio</p>
      <h2
        id="produccion-title"
        class="font-display text-5xl leading-none tracking-tight md:text-7xl"
      >
        Un proceso simple.<br />
        <em class="font-normal text-leaf">Hecho con cuidado.</em>
      </h2>
    </div>

    <div class="mt-16 border-t border-ink/20">
      {
        etapas.map((etapa, index) => (
          <article class="reveal grid gap-4 border-b border-ink/20 py-8 md:grid-cols-[6rem_1fr_1fr] md:items-start md:gap-10 md:py-11">
            <span class="font-display text-2xl text-clay">{etapa.number}</span>
            <h3 class="font-display text-4xl md:text-5xl">{etapa.title}</h3>
            <p class="max-w-lg leading-7 text-ink/65">{etapa.text}</p>
            {index === 1 && (
              <p class="text-xs font-bold uppercase tracking-widest text-leaf md:col-start-3">
                Basado en lineamientos Hy-Line Brown
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
