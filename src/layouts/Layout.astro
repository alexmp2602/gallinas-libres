---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = "Gallinas Libres | Huevos frescos de producción responsable" } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Producción responsable y abastecimiento de huevos frescos de gallinas libres para comercios y mayoristas de la zona."
    />
    <meta name="theme-color" content="#30472c" />
    <link rel="canonical" href="https://www.gallinaslibres.com/" />
    <meta property="og:title" content="Gallinas Libres" /><meta
      property="og:description"
      content="Huevos frescos. Producción responsable. Entregas confiables."
    />
    <meta property="og:type" content="website" /><meta
      property="og:url"
      content="https://www.gallinaslibres.com/"
    />
    <meta
      property="og:image"
      content="https://www.gallinaslibres.com/img/hero-gallinas.webp"
    /><meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/img/hero-gallinas.webp"
      fetchpriority="high"
    />
    <link rel="icon" href="/icons/icon_192.png" /><link
      rel="apple-touch-icon"
      href="/icons/icon_512.png"
    /><link rel="manifest" href="/manifest.json" />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenido"
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-full bg-ink px-5 py-3 text-sm font-bold text-white focus:translate-y-0"
      >Saltar al contenido</a
    >
    <Header /><main id="contenido"><slot /></main><Footer />
    <script is:inline>
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach(
            (entry) =>
              entry.isIntersecting &&
              (entry.target.classList.add("is-visible"),
              observer.unobserve(entry.target)),
          ),
        { threshold: 0.12 },
      );
      document
        .querySelectorAll(".reveal")
        .forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
