---
import Layout from "../layouts/Layout.astro";
const steps = [
  { number:"01", title:"Cuidado", text:"Acompañamos cada etapa de vida respetando el comportamiento natural y el bienestar de nuestras gallinas." },
  { number:"02", title:"Alimentación", text:"Preparamos dietas balanceadas con vitaminas y minerales, ajustadas con precisión según cada etapa." },
  { number:"03", title:"Recolección", text:"Recolectamos todos los días para preservar la frescura, el sabor y la calidad de cada huevo." },
  { number:"04", title:"Distribución", text:"Preparamos los pedidos y coordinamos entregas regulares para comercios y clientes mayoristas." },
];
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://formspree.io/f/myzployj";
---
<Layout>
  <Fragment slot="head"><link rel="preload" as="image" href="/img/hero/hero-gallinas-995.avif" fetchpriority="high" /></Fragment>

  <section id="inicio" class="grain relative flex min-h-[44rem] items-end overflow-hidden bg-forest text-white md:min-h-screen">
    <picture class="absolute inset-0"><source srcset="/img/hero/hero-gallinas-995.avif" type="image/avif" /><source srcset="/img/hero/hero-gallinas-995.webp" type="image/webp" /><img src="/img/hero/hero-gallinas-995.jpg" alt="Gallinas recorriendo libremente el campo" width="995" height="557" fetchpriority="high" class="h-full w-full object-cover" /></picture>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(19,29,17,.82)_0%,rgba(19,29,17,.38)_58%,rgba(19,29,17,.15)_100%)]"></div>
    <div class="site-container relative z-10 pb-14 pt-40 md:pb-20">
      <p class="eyebrow mb-6 text-yolk">Producción local · Goldney</p>
      <h1 class="font-display max-w-4xl text-balance text-[clamp(3.5rem,8vw,7.5rem)] leading-[.89] tracking-[-.05em]">Huevos de gallinas que viven <em class="font-normal text-yolk">libres.</em></h1>
      <div class="mt-9 flex max-w-3xl flex-col gap-7 border-t border-white/30 pt-7 md:flex-row md:items-center md:justify-between">
        <p class="max-w-xl text-lg leading-relaxed text-white/85">Producción responsable y abastecimiento de huevos frescos para comercios y mayoristas.</p>
        <a href="#contacto" class="inline-flex shrink-0 items-center justify-center gap-3 rounded-full bg-yolk px-6 py-4 font-bold text-ink transition hover:bg-white">Consultar por mayorista <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="nosotros" class="py-24 md:py-36">
    <div class="site-container grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
      <div class="reveal"><p class="eyebrow mb-5 text-clay">Nuestra forma de producir</p><p class="max-w-xs text-sm leading-7 text-ink/65">Gallinas Libres nació en el campo, con una idea sencilla: hacer las cosas bien desde el origen.</p></div>
      <div class="reveal"><h2 class="font-display text-balance text-5xl leading-[1.02] tracking-tight md:text-7xl">El bienestar no es un discurso. Es <em class="font-normal text-leaf">cómo trabajamos.</em></h2><p class="mt-8 max-w-2xl text-lg leading-8 text-ink/70">Respetamos la libertad y la naturaleza de nuestras gallinas mientras producimos huevos frescos, consistentes y confiables. Porque la calidad que llega a tu negocio empieza mucho antes: en el cuidado diario.</p></div>
    </div>
  </section>

  <section class="pb-24 md:pb-36">
    <div class="site-container grid gap-5 md:grid-cols-12 md:grid-rows-[17rem_19rem]">
      <figure class="reveal overflow-hidden rounded-[1.5rem] md:col-span-7 md:row-span-2"><img src="/img/produccion/gallinas-libres.webp" alt="Gallinas caminando al aire libre" width="688" height="688" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
      <div class="reveal flex flex-col justify-between rounded-[1.5rem] bg-forest p-8 text-white md:col-span-5 md:p-10"><span class="font-display text-7xl text-yolk">“</span><p class="font-display text-3xl leading-tight md:text-4xl">Libres de verdad. Cuidadas todos los días.</p></div>
      <figure class="reveal overflow-hidden rounded-[1.5rem] md:col-span-5"><img src="/img/produccion/huevos.webp" alt="Huevos frescos recién recolectados" width="853" height="854" loading="lazy" class="h-full w-full object-cover" /></figure>
    </div>
    <div class="site-container mt-10 grid gap-px overflow-hidden rounded-2xl bg-ink/15 sm:grid-cols-2 lg:grid-cols-4">
      {['Movimiento libre','Alimentación balanceada','Recolección diaria','Producción local'].map((item, index) => <div class="reveal bg-paper p-6"><span class="mb-8 block font-display text-3xl text-clay">0{index + 1}</span><p class="font-semibold">{item}</p></div>)}
    </div>
  </section>

  <section id="produccion" class="bg-cream py-24 md:py-36">
    <div class="site-container"><div class="reveal max-w-3xl"><p class="eyebrow mb-5 text-clay">Del campo a tu comercio</p><h2 class="font-display text-5xl leading-none tracking-tight md:text-7xl">Un proceso simple.<br/><em class="font-normal text-leaf">Hecho con cuidado.</em></h2></div>
      <div class="mt-16 border-t border-ink/20">
        {steps.map((step, index) => <article class="reveal grid gap-4 border-b border-ink/20 py-8 md:grid-cols-[6rem_1fr_1fr] md:items-start md:gap-10 md:py-11"><span class="font-display text-2xl text-clay">{step.number}</span><h3 class="font-display text-4xl md:text-5xl">{step.title}</h3><p class="max-w-lg leading-7 text-ink/65">{step.text}</p>{index === 1 && <p class="md:col-start-3 text-xs font-bold uppercase tracking-widest text-leaf">Basado en lineamientos Hy-Line Brown</p>}</article>)}
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-ink py-24 text-white md:py-36">
    <div class="site-container grid gap-12 md:grid-cols-2 md:items-center md:gap-24"><figure class="reveal relative"><div class="absolute -left-5 -top-5 z-10 rounded-full bg-yolk px-5 py-4 text-center font-bold leading-tight text-ink -rotate-6">Frescos<br/>cada día</div><img src="/img/produccion/yema.webp" alt="Yema de un huevo fresco" width="828" height="828" loading="lazy" class="aspect-square w-full rounded-[50%_50%_46%_54%/56%_44%_56%_44%] object-cover" /></figure>
      <div class="reveal"><p class="eyebrow mb-5 text-yolk">El producto</p><h2 class="font-display text-5xl leading-none tracking-tight md:text-7xl">Calidad que se ve. <em class="font-normal text-yolk">Y se nota.</em></h2><p class="mt-8 max-w-xl text-lg leading-8 text-white/70">Cuidamos tamaño, color, resistencia de cáscara y frescura. El resultado son huevos preparados para responder a las necesidades reales de tu comercio.</p><ul class="mt-10 grid grid-cols-2 gap-5 border-t border-white/20 pt-7 text-sm"><li>✓ Frescura garantizada</li><li>✓ Calidad consistente</li><li>✓ Recolección diaria</li><li>✓ Preparados con cuidado</li></ul></div>
    </div>
  </section>

  <section id="mayoristas" class="py-24 md:py-36"><div class="site-container grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-24"><div class="reveal"><p class="eyebrow mb-5 text-clay">Para comercios y mayoristas</p><h2 class="font-display text-balance text-5xl leading-none tracking-tight md:text-7xl">Un proveedor en el que podés <em class="font-normal text-leaf">confiar.</em></h2><p class="mt-8 max-w-xl text-lg leading-8 text-ink/70">Coordinamos pedidos, frecuencia y entregas según las necesidades de cada cliente. Sin vueltas: producto fresco, comunicación directa y cumplimiento.</p><a href="#contacto" class="mt-9 inline-flex rounded-full bg-forest px-7 py-4 font-bold text-white transition hover:bg-ink">Quiero hacer una consulta →</a></div><figure class="reveal overflow-hidden rounded-[1.5rem]"><img src="/img/produccion/maples30.webp" alt="Maples preparados para entrega mayorista" width="828" height="1104" loading="lazy" class="aspect-[4/5] w-full object-cover" /></figure></div></section>

  <section id="ubicacion" class="bg-cream py-24"><div class="site-container grid gap-10 md:grid-cols-2 md:items-end"><div class="reveal"><p class="eyebrow mb-5 text-clay">Dónde estamos</p><h2 class="font-display text-5xl leading-none md:text-7xl">Desde Goldney,<br/><em class="font-normal text-leaf">Buenos Aires.</em></h2></div><div class="reveal md:border-l md:border-ink/20 md:pl-12"><p class="text-lg leading-8 text-ink/70">Estamos en Tranquera 1286, B6614 Goldney. Abastecemos a comercios y mayoristas de la zona con entregas coordinadas.</p><a href="https://www.google.com/maps/place/Tranquera+1286,+B6614+Goldney,+Provincia+de+Buenos+Aires" target="_blank" rel="noopener" class="mt-6 inline-flex font-bold text-clay underline decoration-yolk decoration-2 underline-offset-8">Ver ubicación en Google Maps ↗</a></div></div></section>

  <section id="contacto" class="bg-yolk py-24 md:py-32"><div class="site-container grid gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-24"><div class="reveal"><p class="eyebrow mb-5">Contacto</p><h2 class="font-display text-5xl leading-none tracking-tight md:text-7xl">Hablemos de tu próximo <em class="font-normal text-white">pedido.</em></h2><p class="mt-7 max-w-md leading-7 text-ink/70">Contanos qué necesitás. Te respondemos para conversar cantidades, frecuencia y zona de entrega.</p><a href="https://wa.me/5492324560122?text=Hola%2C%20quiero%20consultar%20por%20huevos%20mayoristas." target="_blank" rel="noopener" class="mt-8 inline-flex rounded-full border-2 border-ink px-6 py-3 font-bold transition hover:bg-ink hover:text-white">Escribir por WhatsApp</a></div>
      <form id="contact-form" action={contactEndpoint} method="POST" class="reveal grid gap-6" aria-describedby="contact-status"><input name="website" class="hidden" tabindex="-1" autocomplete="off" /><div class="grid gap-6 sm:grid-cols-2"><label class="grid gap-2 text-sm font-bold">Nombre y apellido<input required name="name" autocomplete="name" class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none" /></label><label class="grid gap-2 text-sm font-bold">Teléfono<input required name="phone" type="tel" autocomplete="tel" class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none" /></label></div><label class="grid gap-2 text-sm font-bold">Email<input required name="email" type="email" autocomplete="email" class="border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none" /></label><label class="grid gap-2 text-sm font-bold">¿En qué podemos ayudarte?<textarea required name="message" rows="4" class="resize-y border-0 border-b-2 border-ink/40 bg-transparent px-0 py-3 text-lg focus:border-ink focus:outline-none"></textarea></label><input type="hidden" name="_subject" value="Nueva consulta desde gallinaslibres.com" /><button type="submit" class="mt-3 justify-self-start rounded-full bg-ink px-8 py-4 font-bold text-white transition hover:bg-forest disabled:opacity-60">Enviar consulta →</button><p id="contact-status" role="status" aria-live="polite" class="min-h-6 text-sm font-semibold"></p></form>
    </div></section>
  <script is:inline>
    const form = document.querySelector('#contact-form'); const status = document.querySelector('#contact-status');
    form?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); if (data.get('website')) return; const button = form.querySelector('button'); button.disabled = true; status.textContent = 'Enviando…'; try { const response = await fetch(form.action,{method:'POST',headers:{Accept:'application/json'},body:data}); if(!response.ok) throw new Error(); form.reset(); status.textContent='¡Gracias! Te contactamos a la brevedad.'; } catch { status.textContent='No pudimos enviarlo. Probá por WhatsApp o intentá nuevamente.'; } finally { button.disabled=false; } });
  </script>
</Layout>
